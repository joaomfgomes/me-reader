# Modelo de configuração. Copia para .env ("make setup" faz isso) e ajusta.
# O .env verdadeiro nunca entra no git; este ficheiro nunca leva valores secretos.

# Pasta onde ficam a base de dados, os originais, o áudio e os logs.
# Um caminho relativo conta a partir da raiz do repositório.
READER_DATA_DIR=./data

# Porta do backend. O servidor escuta sempre em 127.0.0.1; isso não é configurável.
READER_PORT=8000

# Nível de detalhe dos logs: DEBUG, INFO, WARNING ou ERROR.
READER_LOG_LEVEL=INFO

# As chaves do Azure AI Speech (Fase 2) e do LLM (Fase 3) serão acrescentadas aqui.
