# Modelo de configuração. Copia para .env ("make setup" faz isso) e ajusta.
# O .env verdadeiro nunca entra no git; este ficheiro nunca leva valores secretos.

# Pasta onde ficam a base de dados, os originais, o áudio e os logs.
# Um caminho relativo conta a partir da raiz do repositório.
READER_DATA_DIR=./data

# Porta do backend. O servidor escuta sempre em 127.0.0.1; isso não é configurável.
READER_PORT=8000

# Nível de detalhe dos logs: DEBUG, INFO, WARNING ou ERROR.
READER_LOG_LEVEL=INFO

# Fornecedor de voz: "fake" (simulado, sem chamadas externas nem custos) ou
# "azure" (ainda por implementar).
READER_SPEECH_PROVIDER=fake

# Teto de caracteres enviados ao serviço de voz por mês. Atingido o teto, só
# toca o áudio que já está em cache. 500000 é o escalão gratuito do Azure.
READER_MONTHLY_TTS_CHAR_LIMIT=500000

# Preço por milhão de caracteres, usado só para estimar custos na app.
READER_TTS_USD_PER_MILLION_CHARS=16

# As chaves do Azure AI Speech e do LLM (Fase 3) serão acrescentadas aqui.
