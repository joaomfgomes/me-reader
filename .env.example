# Modelo de configuração. Copia para .env ("make setup" faz isso) e ajusta.
# O .env verdadeiro nunca entra no git; este ficheiro nunca leva valores secretos.

# Pasta onde ficam a base de dados, os originais, o áudio e os logs.
# Um caminho relativo conta a partir da raiz do repositório.
READER_DATA_DIR=./data

# Porta do backend. O servidor escuta sempre em 127.0.0.1; isso não é configurável.
READER_PORT=8000

# Nível de detalhe dos logs: DEBUG, INFO, WARNING ou ERROR.
READER_LOG_LEVEL=INFO

# Fornecedor de voz: "fake" (simulado, sem chamadas externas nem custos) ou
# "azure" (Azure AI Speech; precisa das duas variáveis AZURE_SPEECH_* abaixo).
READER_SPEECH_PROVIDER=fake

# Chave e região do recurso Azure AI Speech (por exemplo, westeurope).
# Só são lidas com READER_SPEECH_PROVIDER=azure. Deixa vazio no .env.example.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Teto de caracteres enviados ao serviço de voz por mês. Atingido o teto, só
# toca o áudio que já está em cache. 500000 é o escalão gratuito do Azure.
READER_MONTHLY_TTS_CHAR_LIMIT=500000

# Preço por milhão de caracteres, usado só para estimar custos na app.
READER_TTS_USD_PER_MILLION_CHARS=16

# Fornecedor do tutor: "fake" (simulado, sem custos) ou "anthropic" (precisa de
# ANTHROPIC_API_KEY), e o modelo a usar.
READER_TUTOR_PROVIDER=fake
READER_TUTOR_MODEL=claude-haiku-5-5

# Chave da API da Anthropic. Usa uma chave só para este projeto, com teto de
# gasto definido na consola. Deixa vazio no .env.example.
ANTHROPIC_API_KEY=

# Teto mensal do tutor, em dólares de custo estimado. Atingido o teto, só são
# mostradas as explicações que já estão em cache.
READER_MONTHLY_LLM_USD_LIMIT=2

# Preços por milhão de tokens do modelo escolhido, usados só para estimar custos.
READER_LLM_INPUT_USD_PER_MILLION_TOKENS=0.10
READER_LLM_OUTPUT_USD_PER_MILLION_TOKENS=0.50
